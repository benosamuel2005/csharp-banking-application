<Window x:Class="BankingApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankingApp.UI"
        mc:Ignorable="d"
        Title="Banking System Login" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">

            <TextBlock Text=" Login" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Username"/>
            <TextBox Name="txtUsername" Margin="0,5,0,10"/>

            <TextBlock Text="Password"/>
            <PasswordBox Name="txtPassword" PasswordChar="*" Margin="0,5,0,20"/>

            <Button Content="Login" Click="Login_Click" Height="30"/>

        </StackPanel>
    </Grid>
</Window>
