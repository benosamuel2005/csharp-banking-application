<Window x:Class="BankingApp.UI.EditAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Account" Height="550" Width="400">

    <ScrollViewer>
        <StackPanel Margin="20">

            <!-- READ ONLY -->
            <TextBlock Text="First Name"/>
            <TextBox Name="txtFirstName" IsReadOnly="True"/>

            <TextBlock Text="Surname"/>
            <TextBox Name="txtLastName" IsReadOnly="True"/>

            <TextBlock Text="Account Number"/>
            <TextBox Name="txtAccountNumber" IsReadOnly="True"/>

            <TextBlock Text="Sort Code"/>
            <TextBox Name="txtSortCode" IsReadOnly="True"/>

            <TextBlock Text="Account Type"/>
            <TextBox Name="txtAccountType" IsReadOnly="True"/>

            <TextBlock Text="Initial Balance"/>
            <TextBox Name="txtBalance" IsReadOnly="True"/>

            <!-- EDITABLE -->
            <TextBlock Text="Email"/>
            <TextBox Name="txtEmail"/>

            <TextBlock Text="Phone"/>
            <TextBox Name="txtPhone"/>

            <TextBlock Text="Address Line 1"/>
            <TextBox Name="txtAddress1"/>

            <TextBlock Text="Address Line 2"/>
            <TextBox Name="txtAddress2"/>

            <TextBlock Text="City"/>
            <TextBox Name="txtCity"/>

            <TextBlock Text="County"/>
            <ComboBox Name="cmbCounty">
                <ComboBoxItem Content="Dublin"/>
                <ComboBoxItem Content="Cork"/>
                <ComboBoxItem Content="Galway"/>
                <ComboBoxItem Content="Limerick"/>
            </ComboBox>

            <TextBlock Text="Overdraft Limit"/>
            <TextBox Name="txtOverdraft"/>

            <Button Content="Update Account" Click="Update_Click" Margin="0,20,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Window>