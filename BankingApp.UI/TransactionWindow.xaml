<Window x:Class="BankingApp.UI.TransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction" Height="300" Width="300">

    <StackPanel Margin="20">

        <TextBlock Text="Account Number"/>
        <TextBox Name="txtAccount" IsReadOnly="True"/>

        <TextBlock Text="Amount"/>
        <TextBox Name="txtAmount"/>

        <Button Content="Deposit" Click="Deposit_Click" Margin="0,10,0,0"/>
        <Button Content="Withdraw" Click="Withdraw_Click" Margin="0,10,0,0"/>

    </StackPanel>
</Window>