<Window x:Class="BankingApp.UI.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Funds" Height="400" Width="400">

    <StackPanel Margin="20">

        <TextBlock Text="Source Account"/>
        <TextBox Name="txtSource" IsReadOnly="True"/>

        <TextBlock Text="Destination Account Number"/>
        <TextBox Name="txtDestAcc"/>

        <TextBlock Text="Destination Sort Code"/>
        <TextBox Name="txtSort"/>

        <TextBlock Text="Amount"/>
        <TextBox Name="txtAmount"/>

        <Button Content="Transfer" Click="Transfer_Click" Margin="0,20,0,0"/>

    </StackPanel>
</Window>